# JWT 鑑權密鑰 (請設置32位元以上隨機字串)
JWT_SECRET=super_secret_pirls_jwt_key_2026_taiwan_reading_literacy

# Google Gemini API Key (可於 Google AI Studio 免費申請: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 資料庫運行模式 (local 或 firebase)
DB_STORAGE_MODE=local

# Firebase 雲端配置 (若切換為 firebase 模式時填寫)
FIREBASE_PROJECT_ID=your-pirls-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
